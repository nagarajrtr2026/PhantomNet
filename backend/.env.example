PHANTOMNET_API_HOST=127.0.0.1
PHANTOMNET_API_PORT=8000
PHANTOMNET_CORS_ORIGINS=["http://localhost:3000"]
PHANTOMNET_EVENT_HISTORY_SIZE=1000
PHANTOMNET_MAX_WEBSOCKET_CLIENTS=100
PHANTOMNET_MAX_SESSIONS=5000
PHANTOMNET_CHROMA_PERSIST_DIRECTORY=./.phantomnet/chroma
PHANTOMNET_CHROMA_COLLECTION=phantomnet_context
PHANTOMNET_OLLAMA_URL=http://127.0.0.1:11434
PHANTOMNET_OLLAMA_MODEL=llama3.1
PHANTOMNET_MAX_INPUT_BYTES=16384
PHANTOMNET_MAX_FILE_BYTES=1048576
PHANTOMNET_NETWORK_CAPTURE_ENABLED=false
PHANTOMNET_FUSE_MOUNTPOINT=
